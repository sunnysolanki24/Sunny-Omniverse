        def Material "Water_Ocean_Blue_Reef"
        {
            token outputs:mdl:displacement.connect = </World/Looks/Water_Ocean_Blue_Reef/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/Water_Ocean_Blue_Reef/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/Water_Ocean_Blue_Reef/Shader.outputs:out>

